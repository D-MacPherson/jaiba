# Existing KDBX database to open.
default_database = "~/.local/share/rama/default.kdbx"

# Optional KeePass keyfile. Leave this unset for password-only databases.
# The master password is always still required.
# keyfile = "~/.local/share/rama/default.keyx"

# Seconds of inactivity before Jaiba locks the database.
auto_lock = 300

# Seconds before a value copied by Jaiba is cleared from the clipboard.
clipboard_timeout = 15

# Name of a theme installed in ~/.config/rama/themes/.
theme = "catppuccin-mocha"

# Optional native YubiKey HMAC-SHA1 factor, IN ADDITION to the password and
# optional keyfile. Explicit serials (nonzero u32 list) and slot (1 or 2) are required.
# Omit the entire table for existing password/password+keyfile vaults.
# This selects an already configured key; Jaiba never programs it.
# Read YUBIKEY.md: touch-enabled keys may block, including cooperative locking.
# [yubikey]
# slot = 2
# serials = [39269826, 39269828]
# Either authorized, already-configured physical key may authenticate. If both
# are accessible, the lowest serial is selected; no mid-operation switching.
# Legacy singleton serial = 39269826 is still accepted, never auto-expanded.
# Do not combine serial and serials. See YUBIKEY-MULTI.md.
